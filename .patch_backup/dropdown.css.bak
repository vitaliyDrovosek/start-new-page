/* ============================================ */
/* DROPDOWN */
/* ============================================ */

/* Выпадающее меню */
.dropdown-container {
    position: fixed;
    bottom: calc(30px + var(--safe-bottom));
    right: calc(30px + var(--safe-right));
    z-index: 1000;
    transition: opacity 0.5s ease;
}

.dropdown-button {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    background: var(--accent);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    font-size: 24px;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(var(--accent-rgb), 0.35);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
    touch-action: manipulation;
    position: relative;
    overflow: hidden;
}

/* Градиент в правом верхнем углу кнопки меню */
.dropdown-button::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(
        circle at top right,
        rgba(255, 255, 255, 0.5) 0%,
        rgba(255, 255, 255, 0.15) 40%,
        transparent 70%
    );
    pointer-events: none;
    opacity: 0.8;
    transition: opacity 0.3s ease;
}

.dropdown-button:hover::before {
    opacity: 1;
}

.dropdown-button:hover {
    transform: scale(1.08);
    box-shadow: 0 4px 20px rgba(var(--accent-rgb), 0.55);
}

.dropdown-menu {
    position: absolute;
    bottom: 70px;
    right: 0;
    background: var(--glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 20px;
    padding: 12px;
    max-width: 95vw;
    width: max-content;
    max-height: 80vh;
    overflow-y: auto;
    border: 1px solid rgba(var(--accent-muted-rgb), 0.4);
    box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.4),
        0 0 30px rgba(var(--accent-deep-rgb), 0.25);
    display: none;
    flex-direction: column;
    gap: 8px;
    z-index: 1001;
}

.dropdown-menu.show {
    display: flex;
}

.dropdown-mobile-close {
    display: none;
    position: absolute;
    top: 10px;
    right: 10px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
    font-size: 16px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    border: 1px solid rgba(var(--accent-soft-rgb), 0.2);
}

.dropdown-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(230px, 1fr));
    gap: 12px;
}

.dropdown-column {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
}

.dropdown-column-title {
    font-size: 0.7rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-secondary);
    opacity: 0.6;
    padding: 4px 8px 6px;
    font-weight: 600;
}

.dropdown-item {
    padding: 12px 20px;
    border: 1px solid rgba(var(--accent-soft-rgb), 0.2);
    border-radius: 15px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    touch-action: manipulation;
    position: relative;
    overflow: hidden;
}

/* Градиент в правом верхнем углу пункта меню */
.dropdown-item::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: radial-gradient(
        circle at top right,
        rgba(var(--accent-bright-rgb), 0.35) 0%,
        rgba(var(--accent-rgb), 0.18) 40%,
        transparent 70%
    );
    pointer-events: none;
    opacity: 0.6;
    transition: opacity 0.3s ease, transform 0.3s ease;
    transform: translate(30%, -30%);
    z-index: 0;
}

.dropdown-item:hover::before {
    opacity: 1;
    transform: translate(15%, -15%) scale(1.2);
}

.dropdown-item > * {
    position: relative;
    z-index: 1;
}

.dropdown-item:hover {
    background: linear-gradient(90deg,
            var(--accent) 0%,
            var(--accent-deep) 100%);
    transform: translateX(-5px);
    border-color: var(--accent-bright);
    box-shadow:
        0 0 20px rgba(var(--accent-bright-rgb), 0.6),
        0 0 40px rgba(var(--accent-rgb), 0.4);
}

.dropdown-item.active {
    background: var(--accent);
    position: relative;
    padding-left: 35px;
}

.dropdown-item.active::after {
    content: "✓";
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
}

.dropdown-menu::-webkit-scrollbar {
    width: 4px;
}

.dropdown-menu::-webkit-scrollbar-track {
    background: transparent;
    margin: 12px 0;
}

.dropdown-menu::-webkit-scrollbar-thumb {
    background: rgba(var(--accent-rgb), 0.25);
    border-radius: 10px;
    transition: background 0.2s ease;
}

.dropdown-menu::-webkit-scrollbar-thumb:hover {
    background: rgba(var(--accent-rgb), 0.45);
}